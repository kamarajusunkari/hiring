# ========================================================
# Arora Tech Solutions - Environment Configuration (.env)
# ========================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials to version control.

# Application Environment
APP_ENV=production          # 'production' or 'development'
APP_DEBUG=false             # Set to true only in local development
APP_URL=https://hire.aroratechsolutions.com
APP_KEY=generate_a_random_64_character_hex_key_here

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arora_hire_db
DB_USER=arora_db_user
DB_PASS=replace_with_strong_password
DB_CHARSET=utf8mb4

# SMTP Mail Server Configuration (PHPMailer)
SMTP_ENABLED=true
SMTP_HOST=smtp.mailgun.org    # e.g., smtp.mailgun.org, smtp.sendgrid.net, smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=tls               # 'tls' (587) or 'ssl' (465)
SMTP_AUTH=true
SMTP_USER=postmaster@hire.aroratechsolutions.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=hire@hire.aroratechsolutions.com
SMTP_FROM_NAME="Arora Tech Solutions"
ADMIN_NOTIFICATION_EMAIL=hire@aroratechsolutions.com

# Anti-Abuse & Rate Limiting
RATE_LIMIT_MAX_SUBMISSIONS=5   # Max enquiry submissions per IP per hour
RATE_LIMIT_WINDOW_SECONDS=3600 # 1 hour window
HONEYPOT_FIELD_NAME=ats_verify_hp
TIMETRAP_MIN_SECONDS=3        # Submissions faster than 3s are flagged as automated bots
