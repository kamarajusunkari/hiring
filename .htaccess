# ========================================================
# Arora Tech Solutions - Root Directory Shield (.htaccess)
# Ensures that if web server points here instead of public/,
# traffic is routed to public/ and sensitive files are blocked.
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct HTTP access to protected application folders
    RewriteRule ^(config|includes|database|docs|logs)/ - [F,L,NC]
    RewriteRule ^\.(env|git) - [F,L,NC]

    # Forward web requests to public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback protection
<FilesMatch "^(\.env|composer\.json|schema\.sql|README\.md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
